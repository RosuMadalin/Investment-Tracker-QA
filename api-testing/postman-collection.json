      "key": "base_url",
      "value": "https://yahoo-finance166.p.rapidapi.com"
    },
    {
      "key": "rapidapi_key",
      "value": "PUT_YOUR_RAPIDAPI_KEY_HERE"
    },
    {
      "key": "rapidapi_host",
      "value": "yahoo-finance166.p.rapidapi.com"
    },
    {
      "key": "firestore_base_url",
